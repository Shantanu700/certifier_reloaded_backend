# Copy to .env and fill in. Loaded by docker/nonprod/docker-compose.yaml (env_file);
# Django does not read .env itself, so export these when running outside the container.

# Postgres (config/settings.py DATABASES)
PROD_POSTGRES_DB=certifier
PROD_POSTGRES_USER=postgres
PROD_POSTGRES_PASSWORD=change-me
PROD_POSTGRES_HOST=postgres
PROD_POSTGRES_PORT=5432

# Celery (Redis broker / result backend)
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# S3-compatible storage (leave AWS_S3_ENDPOINT_URL empty for AWS itself)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ENDPOINT_URL=

# Cloudinary storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OAuth 2.0 Client ID from Google Cloud Console, used to verify Google ID tokens.
GOOGLE_CLIENT_ID=

# Canva Connect integration (Developer Portal -> Your integrations; scopes design:meta:read design:content:read).
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Frontend callback route; must match a redirect URL registered on the integration exactly.
CANVA_REDIRECT_URI=http://127.0.0.1:3000/canva/callback
# Encrypts stored Canva tokens. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CANVA_TOKEN_KEY=

# Signs sessions and email-verification links. Required. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Base URL of the Next.js app, used in links inside emails.
FRONTEND_URL=http://127.0.0.1:3000
# Leave EMAIL_BACKEND unset in dev to print mails to the server log instead of sending them.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Certifier <no-reply@example.com>
