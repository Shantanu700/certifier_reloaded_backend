# Copy to .env and fill in. Loaded by docker/nonprod/docker-compose.yaml (env_file);
# Django does not read .env itself, so export these when running outside the container.

# Postgres (config/settings.py DATABASES)
PROD_POSTGRES_DB=certifier
PROD_POSTGRES_USER=postgres
PROD_POSTGRES_PASSWORD=change-me
PROD_POSTGRES_HOST=postgres
PROD_POSTGRES_PORT=5432

# Celery (Redis broker / result backend)
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# S3-compatible storage (leave AWS_S3_ENDPOINT_URL empty for AWS itself)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ENDPOINT_URL=

# Cloudinary storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
